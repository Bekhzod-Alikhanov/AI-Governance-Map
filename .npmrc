# Required by eslint-plugin-jsx-a11y@6.10.2, whose peer range stops at eslint 9
# while this project uses eslint 10. 6.10.2 is the latest release and the peer
# range has not moved, so the plugin is the blocker, not the project.
#
# This previously also covered react-simple-maps@3, which peer-pinned React 18.
# That dependency has been removed, so jsx-a11y is the only remaining reason.
legacy-peer-deps=true
