{
  "name": "global-ai-governance-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "data:public": "node scripts/write-public-data.mjs",
    "data:map-summary": "node scripts/generate-country-map-summaries.mjs",
    "data:seo": "node scripts/write-seo-files.mjs",
    "build": "npm run data:map-summary && npm run data:public && npm run data:seo && tsc -b && vite build && npm run data:record-previews",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "validate:data": "vitest run src/utils/validateData.test.ts src/utils/governanceTaxonomy.test.ts",
    "validate:export": "vitest run src/utils/exportDataset.test.ts src/utils/datasetSchema.test.ts",
    "audit:sources": "node scripts/audit-sources.mjs",
    "audit:source-links": "node scripts/audit-sources.mjs --check-links",
    "audit:data-review": "node scripts/audit-data-review.mjs",
    "audit:deltas": "node scripts/audit-source-deltas.mjs",
    "audit:deltas:write": "node scripts/audit-source-deltas.mjs --output=docs/SOURCE_DELTA_REPORT.md",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "test:e2e": "node ./scripts/run-playwright.mjs",
    "test:a11y": "node ./scripts/run-playwright.mjs tests/e2e/a11y.spec.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:og": "node scripts/generate-og-image.mjs",
    "audit:manual-checks": "node scripts/check-manual-checks.mjs",
    "data:record-previews": "node scripts/write-record-previews.mjs"
  },
  "overrides": {
    "d3-color": "^3.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-force": "^3.0.10",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  }
}
